{
  "manifest_version": 3,
  "name": "书签管理",
  "version": "1.1.0",
  "description": "美观的书签管理工具 — 毛玻璃设计、分组展示、暗夜主题",
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "app/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "书签管理"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
